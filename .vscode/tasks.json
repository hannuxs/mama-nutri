{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^\\s*(?:ERROR|Error):\\s+(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://localhost:3000/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "quality: check",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "check"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    }
  ]
}
